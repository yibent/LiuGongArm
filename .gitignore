# Upstream clones at repo root only (do not use MR_Liu/ — Windows git is
# case-insensitive and would also ignore source/mr_liu/)
/MR_Liu/
/yoloe/

# Isaac Sim engine (binary install, do not version)
isaac_sim/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Isaac Sim / Omniverse local state
*.log
*.log.*
.nvidia-omniverse/
kit-logs/
ov-cache/
_build/
_compiler/
.cache/

# Vision weights / runs
*.pt
*.ts
runs/
# Keep only the paired GraspGenX release YAMLs; weights/caches stay local.
/_models/**
!/_models/graspgenx/
!/_models/graspgenx/checkpoints/
!/_models/graspgenx/checkpoints/release/
!/_models/graspgenx/checkpoints/release/gen/
!/_models/graspgenx/checkpoints/release/dis/
!/_models/graspgenx/checkpoints/release/gen/config.yaml
!/_models/graspgenx/checkpoints/release/dis/config.yaml
/_envs/
/_vendor/

# Fine-grasp local benchmark artifacts
/benchmarks/artifacts/
/output/

# Editor / OS
.vscode/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db
desktop.ini

# Generated captures
output/
captures/
*.png.bak

busagent-report.pdf
