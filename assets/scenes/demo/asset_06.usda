#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.08

    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        token outputs:surface.connect = </Asset/Material/Shader.outputs:surface>
        float physics:dynamicFriction = 1
        float physics:restitution = 0
        float physics:staticFriction = 1.2

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.55, 0.57, 0.59)
            float inputs:metallic = 0.8
            float inputs:roughness = 0.3
            token outputs:surface
        }
    }

    def Cube "piece_001" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </Asset/Material>
        rel material:binding:physics = </Asset/Material>
        double size = 1
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (0.14, 0.12, 0.01)
        double3 xformOp:translate = (0, 0, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cylinder "piece_002" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.065
        rel material:binding = </Asset/Material>
        rel material:binding:physics = </Asset/Material>
        double radius = 0.007
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:translate = (-0.042, 0, 0.0425)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Cylinder "piece_003" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.065
        rel material:binding = </Asset/Material>
        rel material:binding:physics = </Asset/Material>
        double radius = 0.007
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:translate = (0.042, 0, 0.0425)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

