format: xrdf
format_version: 2.0

default_joint_positions:
  shoulder_pan: 0.0
  shoulder_lift: -1.2
  elbow_flex: 1.3
  wrist_flex: 1.2
  wrist_roll: 0.0
  gripper: 0.0

cspace:
  joint_names:
    - "shoulder_pan"
    - "shoulder_lift"
    - "elbow_flex"
    - "wrist_flex"
    - "wrist_roll"
  acceleration_limits: [8.0, 8.0, 8.0, 10.0, 10.0]
  jerk_limits: [400.0, 400.0, 400.0, 500.0, 500.0]

tool_frames: ["gripper_frame_link"]

world_collision:
  geometry: "so101_collision_spheres"

self_collision:
  geometry: "so101_self_collision_spheres"
  ignore:
    base_link: ["shoulder_link"]
    shoulder_link: ["upper_arm_link"]
    upper_arm_link: ["lower_arm_link"]
    lower_arm_link: ["wrist_link"]
    wrist_link: ["gripper_link", "gripper_frame_link"]
    gripper_link: ["gripper_frame_link", "moving_jaw_so101_v1_link"]
    gripper_frame_link: ["moving_jaw_so101_v1_link"]

geometry:
  so101_collision_spheres:
    spheres:
      base_link:
        - center: [0.02, 0.0, 0.04]
          radius: 0.05
      shoulder_link:
        - center: [-0.03, 0.0, -0.025]
          radius: 0.04
      upper_arm_link:
        - center: [-0.04, 0.0, 0.018]
          radius: 0.035
        - center: [-0.09, 0.0, 0.018]
          radius: 0.032
      lower_arm_link:
        - center: [-0.04, 0.0, 0.018]
          radius: 0.03
        - center: [-0.10, 0.0, 0.018]
          radius: 0.028
      wrist_link:
        - center: [0.0, -0.03, 0.018]
          radius: 0.028
      gripper_link:
        - center: [0.0, 0.0, -0.04]
          radius: 0.03
      gripper_frame_link:
        - center: [0.0, 0.0, 0.0]
          radius: 0.018
      moving_jaw_so101_v1_link:
        - center: [0.0, -0.03, 0.02]
          radius: 0.018
  so101_self_collision_spheres:
    spheres:
      base_link:
        - center: [0.02, 0.0, 0.04]
          radius: 0.045
      shoulder_link:
        - center: [-0.03, 0.0, -0.025]
          radius: 0.035
      upper_arm_link:
        - center: [-0.09, 0.0, 0.018]
          radius: 0.03
      lower_arm_link:
        - center: [-0.10, 0.0, 0.018]
          radius: 0.026
      wrist_link:
        - center: [0.0, -0.03, 0.018]
          radius: 0.024
      gripper_link:
        - center: [0.0, 0.0, -0.04]
          radius: 0.026
      gripper_frame_link:
        - center: [0.0, 0.0, 0.0]
          radius: 0.016
      moving_jaw_so101_v1_link:
        - center: [0.0, -0.03, 0.02]
          radius: 0.016
