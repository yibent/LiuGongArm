<?xml version="1.0" encoding="utf-8"?>
<!-- Kinematics-only SO-101 URDF for cuMotion. Joint origins/limits match
     TheRobotStudio so101_new_calib.urdf; meshes replaced by capsules so
     planning does not depend on STL files. -->
<robot name="so101_new_calib">

  <link name="base_link">
    <inertial>
      <origin xyz="0.0137179 -5.19711e-05 0.0334843" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="0.000114686" ixy="0" ixz="0" iyy="0.000136117" iyz="0" izz="0.000130364"/>
    </inertial>
    <visual>
      <origin xyz="0.02 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.08"/></geometry>
    </visual>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="-0.0307604 -1.66727e-05 -0.0252713" rpy="0 0 0"/>
      <mass value="0.100006"/>
      <inertia ixx="8.3759e-05" ixy="0" ixz="0" iyy="8.10403e-05" iyz="0" izz="2.39783e-05"/>
    </inertial>
    <visual>
      <origin xyz="-0.03 0 -0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
    </visual>
  </link>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="-0.0898471 -0.00838224 0.0184089" rpy="0 0 0"/>
      <mass value="0.103"/>
      <inertia ixx="4.08002e-05" ixy="0" ixz="0" iyy="0.000147318" iyz="0" izz="0.000142487"/>
    </inertial>
    <visual>
      <origin xyz="-0.056 0 0.018" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.022" length="0.11"/></geometry>
    </visual>
  </link>

  <link name="lower_arm_link">
    <inertial>
      <origin xyz="-0.0980701 0.00324376 0.0182831" rpy="0 0 0"/>
      <mass value="0.104"/>
      <inertia ixx="2.87438e-05" ixy="0" ixz="0" iyy="0.000159844" iyz="0" izz="0.00014529"/>
    </inertial>
    <visual>
      <origin xyz="-0.067 0 0.018" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.02" length="0.13"/></geometry>
    </visual>
  </link>

  <link name="wrist_link">
    <inertial>
      <origin xyz="-0.000103312 -0.0386143 0.0281156" rpy="0 0 0"/>
      <mass value="0.079"/>
      <inertia ixx="3.68265e-05" ixy="0" ixz="0" iyy="2.74474e-05" iyz="0" izz="1.89434e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03 0.018" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.02" length="0.06"/></geometry>
    </visual>
  </link>

  <link name="gripper_link">
    <inertial>
      <origin xyz="0.000213627 0.000245138 -0.025187" rpy="0 0 0"/>
      <mass value="0.087"/>
      <inertia ixx="2.42839e-05" ixy="0" ixz="0" iyy="4.33735e-05" iyz="0" izz="3.77229e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.018" length="0.08"/></geometry>
    </visual>
  </link>

  <link name="gripper_frame_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>

  <link name="moving_jaw_so101_v1_link">
    <inertial>
      <origin xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="6.61427e-06" ixy="0" ixz="0" iyy="1.89032e-06" iyz="0" izz="5.28738e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.03 0.019" rpy="0 0 0"/>
      <geometry><box size="0.02 0.05 0.02"/></geometry>
    </visual>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.0207909 -0.0230745 0.0948817" rpy="3.14159 0 1.5708"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.91986" upper="1.91986"/>
  </joint>

  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.74533" upper="1.74533"/>
  </joint>

  <joint name="elbow_flex" type="revolute">
    <origin xyz="-0.11257 -0.028 0" rpy="0 0 1.5708"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.69" upper="1.69"/>
  </joint>

  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.0052 0" rpy="0 0 -1.5708"/>
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.65806" upper="1.65806"/>
  </joint>

  <joint name="wrist_roll" type="revolute">
    <origin xyz="0 -0.0611 0.0181" rpy="1.5708 0 3.14159"/>
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-2.74385" upper="2.84121"/>
  </joint>

  <joint name="gripper_frame_joint" type="fixed">
    <origin xyz="-0.0079 0 -0.0981274" rpy="0 3.14159 0"/>
    <parent link="gripper_link"/>
    <child link="gripper_frame_link"/>
  </joint>

  <joint name="gripper" type="revolute">
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 0 0"/>
    <parent link="gripper_link"/>
    <child link="moving_jaw_so101_v1_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533"/>
  </joint>

</robot>
